# Default arguments and multiple returns
from math import sqrt

def describe_number(x=4.0):
    is_integer = float(x).is_integer()
    return x, x**2, sqrt(x), is_integer

value, squared, root, is_int = describe_number(9)
print(value, squared, root, is_int)
